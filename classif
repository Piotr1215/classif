BASH_COMPLETION = r"""# Generated by classif completion bash. The candidates come from classif
# __complete, so new flags and specs complete without generating this again.
_classif() {
    local out v
    # classif splits the line itself: bash would split FIELD=VALUE at the =.
    out=$(classif __complete --line "${COMP_LINE:0:COMP_POINT}" 2>/dev/null)
    if [[ $out == :files ]]; then
