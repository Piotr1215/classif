def parser():
    ap = argparse.ArgumentParser(prog="classif", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("specs", help="list the specs, the fields each wants and where each lives")
    c = sub.add_parser(
        "classify", help="score one item: field=value ...", formatter_class=cls.Help, epilog=CLASSIFY_EPILOG,
        usage="%(prog)s [--hook HOOK] SPEC FIELD=VALUE ...",
        description="Ask a spec's saved question about one item. The spec holds the question, the labels, the "
                    "model and a text template with a {FIELD} slot for each field it declares; FIELD=VALUE fills "
                    "one, so a caller passes only what changes per item. classif specs lists each spec's fields.")
    c.add_argument("spec", metavar="SPEC", help="a spec's name, as classif specs lists it")
    c.add_argument("--hook", default="classify", help="consumer name on the log row, for histogram --hook")
    c.add_argument("fields", nargs="+", metavar="FIELD=VALUE",
                   help="one per field the spec declares. VALUE is any text, cut to the field's cap, so a file "
                        "goes in as field=\"$(cat FILE)\". An empty or missing field leaves the item unscored")
    sm = sub.add_parser("smoke", help="check a spec's smoke rows on a live model")
    sm.add_argument("spec")
    sub.add_parser("unload", help="unload the models classif loads, e.g. before a game needs the GPU; the next call loads them again")
    h = sub.add_parser("histogram", help="p histogram from the log, with the valley; no spec lists what the log holds")
    h.add_argument("spec", nargs="?", help="spec to draw; omit to list the spec and hook pairs with rows")
    h.add_argument("--hook", help="only rows this hook logged")
    h.add_argument("--days", type=float, help="only rows from the last N days")
    cp = sub.add_parser("completion", help="print tab completion for bash or zsh", formatter_class=cls.Help,
                        epilog=COMPLETION_EPILOG, description="Print a tab completion script for bash or zsh.")
    cp.add_argument("shell", choices=("bash", "zsh"), help="the shell to complete in")
    return ap


def subcommands(ap):
    """{name: (parser, help)} for classif's own subcommands."""
    act = next(a for a in ap._actions if isinstance(a, argparse._SubParsersAction))
    helps = {c.dest: c.help for c in act._choices_actions}
    return {n: (p, helps.get(n, "")) for n, p in act.choices.items()}


def gist(text):
    """A help text's first clause, short enough for a completion menu."""
    return " ".join((text or "").split()).split(". ")[0].split("; ")[0][:70]


def split_line(line):
    """Words after the command in a shell line typed so far; a trailing space
    starts an empty word. An open quote is closed so the word in it counts."""
    for tail in ("", '"', "'"):
        try:
            words = shlex.split(line + tail)
            break
        except ValueError:
            continue
    else:
        words = line.split()
    if not line or line[-1].isspace():
        words.append("")
    return words[1:]


def complete(words):
    """Candidates for the last word, the one being typed: (value, description)
    pairs. A slot that takes a file gives (":files", "") alone, so the shell
    completes paths itself. Flags come from the parsers and specs from the
    spec dirs, so neither needs the shell script generated again."""
    *done, cur = words or [""]
    subs = subcommands(parser())
    if not done and not cur.startswith("-"):
        helps = dict(PERSON_COMMANDS)
        return [(n, helps.get(n) or gist(subs[n][1])) for n in COMMANDS if n.startswith(cur)]
    if done and done[0] in subs:
        p, args = subs[done[0]][0], done[1:]
    elif done and done[0] in ("tag", "each"):
        p, args = (cls.tag_parser() if done[0] == "tag" else cls.each_parser()), done[1:]
    else:
        p, args = cls.main_parser(), done
    opts = {o: a for a in p._actions for o in a.option_strings}
    if args and args[-1] in opts and opts[args[-1]].nargs != 0:
        return [(":files", "")] if opts[args[-1]].dest in FILE_DESTS else []
    if cur.startswith("-"):
        return [(o, gist(a.help)) for a in p._actions if a.help != argparse.SUPPRESS
                for o in a.option_strings if o.startswith(cur)]
    given, skip = [], False
    for w in args:
        if skip:
            skip = False
        elif w in opts:
            skip = opts[w].nargs != 0
        elif not w.startswith("-"):
            given.append(w)
    slots = [a for a in p._actions if not a.option_strings]
    if not slots:
        return []
    slot = slots[len(given)] if len(given) < len(slots) else slots[-1]
    if len(given) >= len(slots) and slot.nargs not in ("+", "*"):
        return []
    if slot.choices:
        return [(c, "") for c in slot.choices if c.startswith(cur)]
    if slot.dest == "spec":
        out = []
        for n in spec_names():
            try:
                q = load_spec(n).get("question", "")
            except (OSError, ValueError):
                q = "unreadable"
            if n.startswith(cur):
                out.append((n, gist(q)))
        return out
    if slot.dest == "fields" and given and "=" not in cur:
        try:
            fields = load_spec(given[0])["fields"]
        except (OSError, ValueError, KeyError, TypeError):
            return []
        have = {w.split("=", 1)[0] for w in given[1:]}
        return [(f"{k}=", f"up to {n} chars") for k, n in fields.items()
                if k not in have and k.startswith(cur)]
    return []


def main():
    first = sys.argv[1] if len(sys.argv) > 1 else None
    if first == "__complete":
        words = sys.argv[2:]
        if words[:1] == ["--line"]:
            words = split_line(words[1] if len(words) > 1 else "")
        for value, what in complete(words):
            print(f"{value}\t{what}" if value != ":files" else value)
        return 0

    if first is None:
        # Piped text with no question has nothing to be judged against.
        print("classif: pass a question or a command; see classif -h", file=sys.stderr)
        return 2
    if first == "tag":
        return cls.tag_main(sys.argv[2:])
    if first == "rank":
        # Renamed: read as a question, an old call would answer something else.
        print("classif: rank is now each: classif each QUESTION ITEM ...; its JSON rows are under items",
              file=sys.stderr)
        return 2
    if first == "each":
        try:
            return cls.each_main(sys.argv[2:])
        except BrokenPipeError:
            # A reader such as head -3 has what it wanted.
            return 0
    if first not in COMMANDS and first not in ("-h", "--help"):
        try:
            return cls.main(sys.argv[1:], prog="classif")
        except BrokenPipeError:
            # As in the judge: only the gate's write of the input can fill the pipe, after the verdict.
            return 0
    if first in ("-h", "--help"):
        # The question form first: it is what most calls are.
        try:
            cls.main(["-h"], prog="classif")
        except SystemExit:
            pass
        print("\nCommands: classif COMMAND ..., see classif COMMAND -h")
        for name, what in PERSON_COMMANDS:
            print(f"  {name:13} {what}")
        print("For hooks and spec authoring: classify, smoke")
        print("\nFull documentation <https://github.com/Piotr1215/classif>")
        return 0
    a = parser().parse_args()
    if getattr(a, "spec", None) and a.spec not in spec_names():
        print(f"classif {a.cmd}: no spec named {a.spec}; specs: {', '.join(spec_names()) or 'none'} "
              f"(looked in {', '.join(spec_dirs())})", file=sys.stderr)
        return 2
    if a.cmd == "specs":
        print(specs())
        return 0
    if a.cmd == "classify":
        return classify(a.spec, a.fields, a.hook)
    if a.cmd == "smoke":
        return smoke(a.spec)
    if a.cmd == "unload":
        return unload()
    if a.cmd == "completion":
        print(ZSH_COMPLETION if a.shell == "zsh" else BASH_COMPLETION, end="")
        return 0
    print(histogram(a.spec, a.hook, a.days) if a.spec else histograms(a.days))
    return 0


if __name__ == "__main__":
    try:
        code = main()
    except KeyboardInterrupt:
        # Ctrl-C ends a long read: wipe the progress line, no traceback.
        sys.stderr.write("\r\033[K" if sys.stderr.isatty() else "")
        code = 130
    # The judge's gate swaps sys.stdout for stderr, so flush the real one.
    cls.flush_all()
    # A probe thread stuck resolving an absent .local host holds normal exit.
    os._exit(code)
